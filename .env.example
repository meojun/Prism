# Copy to the file exp/scripts/env.sh sources -- by default /workspace/.env --
# and fill in real values there. That file lives OUTSIDE the repository and is
# never committed. This example carries names only.
#
#   cp .env.example /workspace/.env && chmod 600 /workspace/.env && $EDITOR /workspace/.env

# Hugging Face access token. Needed because meta-llama/Llama-3.2-* are gated;
# without it the model downloads fail with 401 and the server never starts.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ntfy.sh topic for push notifications from the pipeline. Optional: leave it
# unset and the harness logs to exp/results/final-evaluation/notification.log
# instead. Treat the topic as a secret -- anyone who knows it can read the
# notifications and post to it.
PRISM_NTFY_TOPIC=your-private-topic-name

# --- optional, only if you move things off their defaults --------------------
# PRISM_ROOT=/workspace/prism-exp        # install root (bootstrap.sh default)
# DATASETS=/workspace/datasets           # ShareGPT source data
# HF_HOME=/workspace/.hf_home            # model cache
# PRISM_BACKUP_DIR=/workspace/prism-backups   # off-repo artifact backups
#
# FLASHINFER_WORKSPACE_SIZE is NOT set here. exp/scripts/env.sh pins it to
# 1 GiB after sourcing this file, deliberately, so a stale copy cannot lower
# it: at the upstream default of 384 MiB, model_6 asks for more during prefill
# and the server kills itself mid-run.
