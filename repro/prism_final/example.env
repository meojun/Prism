# Copy to a location OUTSIDE this repository (e.g. $WORKSPACE/.env) and fill in.
# Never commit real values.

# Required to download the gated meta-llama repositories.
HUGGING_FACE_HUB_TOKEN=<PASTE_YOUR_HF_TOKEN_HERE>

# Optional. Phone notifications; absence is handled silently.
PRISM_NTFY_TOPIC=your-ntfy-topic-here

# Non-secret paths.
HF_HOME=/workspace/.hf_home
SHAREGPT_JSON=/workspace/datasets/sharegpt/ShareGPT_V3_unfiltered_cleaned_split.json
