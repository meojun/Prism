+    def _gpu_scheduler_alive(self, gpu_id) -> bool:
+        """True when the GPU scheduler's IPC endpoint still exists.
+
+        A scheduler that leaves its loop removes this file during cleanup, so
+        absence means no peer will ever answer. Unknown gpu_id or a missing
+        registry is treated as alive, so this can only ever refuse a request it
+        is certain about.
+        """
+        name = getattr(self, "gpu_scheduler_ipc_name", {}).get(gpu_id)
+        if name is None:
+            return True
+        return os.path.exists(name)
