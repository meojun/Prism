+        # Paper Appendix A.4 states KVPR consumes a sliding-window moving
+        # average of token rates.  Keep raw decode-token counts with the wall
+        # clock at which the engine reported them, so the decode component of
+        # token_rate obeys the same window semantics as the input component
+        # rather than being a cached short-interval achieved throughput.
+        self.decode_token_events: deque = deque()
+
+    def record_decode_tokens(self, timestamp: float, count: int) -> None:
+        """Record one engine report of decode tokens produced since its last."""
+        if count:
+            self.decode_token_events.append((timestamp, int(count)))
+
+    def decode_token_rate(self, now: float, window: float) -> float:
+        """Decode tokens produced in the last ``window`` seconds, per second.
+
+        Events leave by wall clock, so a model that stops producing -- idle,
+        deactivated, or migrating -- decays to zero on its own and no stale
+        value can persist.  The denominator is the configured window, the same
+        constant the input component divides by, so both halves of token_rate
+        share one time base.
+        """
+        cutoff = now - window
+        events = self.decode_token_events
+        while events and events[0][0] < cutoff:
+            events.popleft()
+        return sum(count for _, count in events) / window
+
